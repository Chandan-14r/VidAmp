{
  "manifest_version": 3,
  "name": "VidAmp - Universal Video Enhancer & Speed Controller",
  "short_name": "VidAmp",
  "version": "6.2.1",
  "description": "Speed controller, trackpad gestures, 600% volume boost, studio EQ, ambient glow, frame stepper, and A-B loop for all web videos.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "512": "icons/icon512.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vidamp-enhancer@community.addons",
      "strict_min_version": "109.0"
    }
  }
}
